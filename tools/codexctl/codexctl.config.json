{
  "project_root": "~/RESIDUUM",
  "codex": {
    "bin": "codex",
    "model": null,
    "model_tiers": {
      "simple": "gpt-5.6-terra",
      "core": "gpt-5.6-sol"
    },
    "reasoning_effort": "high",
    "sandbox": "workspace-write",
    "approval": "never",
    "extra_args": [],
    "timeout_sec": 2400,
    "stall_timeout_sec": 360,
    "use_subscription_auth": true,
    "env": {}
  },
  "unity": {
    "enabled": true,
    "editor_path": null,
    "hub_roots": [
      "/Applications/Unity/Hub/Editor",
      "~/Applications/Unity/Hub/Editor"
    ],
    "extra_args": [],
    "timeout_sec": 2400,
    "project_scope_prefix": "Assets/_Project"
  },
  "git": {
    "branch_prefix": "codex/",
    "auto_branch": true,
    "auto_commit": false,
    "base_branch": "main"
  },
  "repair": {
    "max_attempts": 2
  },
  "contract_files": [
    "Assets/_Project/Scripts/Core/GameEvents.cs",
    "Assets/_Project/Scripts/Core/RoundResult.cs",
    "Assets/_Project/Scripts/Evidence/EvidenceType.cs",
    "Assets/_Project/Scripts/Evidence/IEvidenceSource.cs",
    "Assets/_Project/Scripts/Core/IInteractable.cs",
    "Assets/_Project/Scripts/Items/IHoldable.cs",
    "Assets/_Project/Scripts/Ghost/GhostDefinition.cs"
  ],
  "gate_rules": [
    {
      "id": "G01",
      "severity": "error",
      "pattern": "\\bFindObjectsOfType\\b|\\bFindObjectOfType\\b|\\bFindFirstObjectByType\\b|\\bFindObjectsSortMode\\b",
      "message": "Unity 6.x 已弃用：FindObjectOfType / FindObjectsOfType / FindFirstObjectByType / 带 FindObjectsSortMode 的重载。用 FindAnyObjectByType 或 FindObjectsByType(FindObjectsInactive.…)"
    },
    {
      "id": "G02",
      "severity": "error",
      "pattern": "\\b(?:rb|rigidbody|_rb|_rigidbody|Rigidbody)\\s*\\.\\s*velocity\\b",
      "message": "Rigidbody.velocity 在 Unity 6 已改名 linearVelocity"
    },
    {
      "id": "G03",
      "severity": "error",
      "pattern": "\\bUnityEngine\\.Input\\.|(?<![\\w.])Input\\s*\\.\\s*(?:GetKey|GetAxis|GetButton|GetMouse|mousePosition)",
      "message": "禁止旧版 Input Manager，本项目统一走 Input System"
    },
    {
      "id": "G04",
      "severity": "error",
      "pattern": "\\bCinemachineVirtualCamera\\b",
      "message": "Cinemachine 3.x 已改名 CinemachineCamera"
    },
    {
      "id": "G05",
      "severity": "error",
      "pattern": "^\\s*using\\s+Residuum\\.(?!Core\\b|Evidence\\b)",
      "message": "模块之间禁止直接 using（Core 与 Evidence 的枚举/接口除外），跨模块通信走 GameEvents"
    },
    {
      "id": "G06",
      "severity": "warn",
      "pattern": "^\\s*public\\s+(?:float|int|bool|string|Vector[23])\\s+\\w+\\s*(?:=[^=>]|;)",
      "message": "可调数值应当 [SerializeField] private，而非 public 字段"
    },
    {
      "id": "G07",
      "severity": "warn",
      "pattern": "\\bGameObject\\.Find\\s*\\(",
      "message": "GameObject.Find 按名字查找脆弱，改用序列化引用",
      "exclude": [
        "**/Editor/**"
      ]
    },
    {
      "id": "G08",
      "severity": "warn",
      "pattern": "\\bDebug\\.Log\\s*\\(",
      "message": "提交前清理调试日志（或改用条件编译）",
      "exclude": [
        "**/Editor/**"
      ]
    }
  ],
  "gate_include": [
    "Assets/_Project/Scripts/**/*.cs"
  ],
  "audit_checklist": [
    {
      "id": "A01",
      "text": "除 Residuum.Core / Residuum.Evidence 的枚举与接口外，未 using 或引用其它模块的具体类。【豁免】Scripts/**/Editor/ 下的编辑器装配工具不受此限：把各模块组件在场景里连起来正是它的职责，用全限定名引用具体类型属于预期，判 n/a"
    },
    {
      "id": "A02",
      "text": "命名空间为 Residuum.<指定模块名>"
    },
    {
      "id": "A03",
      "text": "未修改 GameEvents 或任何接口的定义"
    },
    {
      "id": "A04",
      "text": "文件名与主类名完全一致"
    },
    {
      "id": "A05",
      "text": "每个 GameEvents 订阅在 OnEnable 订阅、OnDisable 取消，严格配对且数量相等"
    },
    {
      "id": "A06",
      "text": "所有 StartCoroutine 启动的协程都在 OnDisable 中停止"
    },
    {
      "id": "A07",
      "text": "OnDestroy 时没有未清理的引用或计时器"
    },
    {
      "id": "A08",
      "text": "零 FindObjectOfType / FindObjectsOfType / FindFirstObjectByType（用 FindAnyObjectByType；批量用 FindObjectsByType(FindObjectsInactive.Include)，不传 FindObjectsSortMode）"
    },
    {
      "id": "A09",
      "text": "零 Rigidbody.velocity（Unity 6 改名 linearVelocity）"
    },
    {
      "id": "A10",
      "text": "零旧版输入 Input.GetKey / GetAxis / mousePosition（统一 Input System）"
    },
    {
      "id": "A11",
      "text": "零 Cinemachine 2.x 类名（CinemachineVirtualCamera → CinemachineCamera，本工程 3.1.7）"
    },
    {
      "id": "A12",
      "text": "Update 中不重复调用 Camera.main（Awake 缓存）；协程内不反复 new WaitForSeconds"
    },
    {
      "id": "A13",
      "text": "没有硬编码数值常量（速度/时长/概率/距离/角度），全部 [SerializeField] private。【豁免】Scripts/**/Editor/ 下的编辑器工具不受此限：它生成物体时用的一次性几何参数不是设计师需要在 Inspector 里调的运行时数值，判 n/a"
    },
    {
      "id": "A14",
      "text": "每个 [SerializeField] 字段都有 [Tooltip(\"中文说明\")]。【豁免】Scripts/**/Editor/ 下的编辑器工具判 n/a"
    },
    {
      "id": "A15",
      "text": "数值字段默认值合理，且与设计文档一致"
    },
    {
      "id": "A16",
      "text": "GetComponent / 引用字段使用前做 null 检查；关键依赖缺失用 Debug.LogError 明确报出，不静默失败"
    },
    {
      "id": "A17",
      "text": "没有除零、数组越界、负数开方等风险"
    },
    {
      "id": "A18",
      "text": "代码完整：无 \"...\" 省略、无 TODO 占位、可直接编译"
    }
  ]
}
